# Server only. Never prefix secrets with VITE_. Copy to .env (ignored).
NODE_ENV=development
PORT=8787
APP_ORIGIN=http://localhost:5173
# Additional exact HTTPS origins for temporary Render preview, comma-separated.
APP_ALLOWED_ORIGINS=
# localhost development only. Production MUST be true + https origin.
COOKIE_SECURE=false
# Only behind your local reverse proxy which overwrites X-Forwarded-For.
TRUST_LOCAL_PROXY=false
# Use Supabase session pooler/direct connection, SSL, least-privileged BFF DB role.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Generate with: node -e "process.stdout.write(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_ENCRYPTION_KEY=
# JSON credentials in a server-only file outside repository; on Render use a Secret File at /etc/secrets/google-drive.json.
GOOGLE_APPLICATION_CREDENTIALS=
# Alternative for hosts without secret files: base64 of the same JSON, server-only.
GOOGLE_APPLICATION_CREDENTIALS_BASE64=
DRIVE_ALLOWED_FOLDER_IDS=
# Explicit comma-separated emails owner/backend/trusted teachers. Public/extra permissions reject publication.
DRIVE_ALLOWED_PERMISSION_EMAILS=
DRIVE_OWNER_USER_ID=
DRIVE_OWNER_EMAIL=
# The Google OAuth Web client redirect must exactly equal
# ${APP_ORIGIN}/api/drive/oauth/callback (production: https://uyym.app/api/drive/oauth/callback).
DRIVE_OAUTH_CLIENT_ID=
DRIVE_OAUTH_CLIENT_SECRET=
DRIVE_OAUTH_ENCRYPTION_KEY=
CONTENT_MAX_FILE_BYTES=5242880
CONTENT_MAX_FILES=5
